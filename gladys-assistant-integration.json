{
  "manifest_version": 1,
  "type": "device",
  "name": "Veolia",
  "description": {
    "en": "Your water consumption from your Veolia customer account (eau.veolia.fr).",
    "fr": "Votre consommation d'eau depuis votre espace client Veolia (eau.veolia.fr).",
    "de": "Ihr Wasserverbrauch aus Ihrem Veolia-Kundenkonto (eau.veolia.fr).",
    "es": "Su consumo de agua desde su área de cliente de Veolia (eau.veolia.fr)."
  },
  "version": "1.0.3",
  "docker_image": "ghcr.io/prohand/gladys-veolia:1.0.3",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-veolia/main/cover.png",
  "categories": ["energy", "environment"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Your home needs a remote-read water meter (télérelève) and a Veolia customer account. Enter the e-mail and password you use on the Veolia website. Not sure your town is served by Veolia? Use the \"Check my town\" button below.",
        "fr": "Votre logement doit avoir un compteur d'eau télérelevé et un espace client Veolia. Indiquez l'e-mail et le mot de passe utilisés sur le site Veolia. Un doute sur votre commune ? Utilisez le bouton « Vérifier ma commune » ci-dessous.",
        "de": "Ihr Zuhause braucht einen fernablesbaren Wasserzähler (télérelève) und ein Veolia-Kundenkonto. Geben Sie die E-Mail-Adresse und das Passwort ein, die Sie auf der Veolia-Website verwenden. Sie sind nicht sicher, ob Ihre Gemeinde von Veolia versorgt wird? Nutzen Sie unten die Schaltfläche „Meine Gemeinde prüfen“.",
        "es": "Su vivienda necesita un contador de agua con telelectura (télérelève) y un área de cliente de Veolia. Introduzca el e-mail y la contraseña que usa en la web de Veolia. ¿No sabe si Veolia abastece su municipio? Use el botón «Comprobar mi municipio» de abajo."
      },
      "links": [
        {
          "url": "https://github.com/prohand/gladys-veolia/blob/main/docs/fr.md",
          "label": {
            "en": "Step-by-step guide",
            "fr": "Guide pas à pas",
            "de": "Schritt-für-Schritt-Anleitung",
            "es": "Guía paso a paso"
          }
        },
        {
          "url": "https://www.eau.veolia.fr",
          "label": {
            "en": "Veolia customer portal",
            "fr": "Espace client Veolia",
            "de": "Veolia-Kundenportal",
            "es": "Área de cliente de Veolia"
          }
        }
      ]
    },
    {
      "key": "email",
      "type": "string",
      "label": {
        "en": "Veolia e-mail",
        "fr": "E-mail Veolia",
        "de": "Veolia-E-Mail",
        "es": "E-mail de Veolia"
      },
      "description": {
        "en": "The e-mail address of your Veolia customer account.",
        "fr": "L'adresse e-mail de votre espace client Veolia.",
        "de": "Die E-Mail-Adresse Ihres Veolia-Kundenkontos.",
        "es": "La dirección de e-mail de su área de cliente de Veolia."
      },
      "placeholder": {
        "en": "e.g. me@example.com",
        "fr": "ex. moi@exemple.fr",
        "de": "z. B. ich@beispiel.de",
        "es": "p. ej. yo@ejemplo.es"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Veolia password",
        "fr": "Mot de passe Veolia",
        "de": "Veolia-Passwort",
        "es": "Contraseña de Veolia"
      },
      "required": true
    },
    {
      "key": "portal",
      "type": "select",
      "label": {
        "en": "Customer portal",
        "fr": "Espace client",
        "de": "Kundenportal",
        "es": "Área de cliente"
      },
      "description": {
        "en": "Keep eau.veolia.fr unless your town redirects you to its own Veolia portal.",
        "fr": "Gardez eau.veolia.fr sauf si votre commune vous redirige vers son propre portail Veolia.",
        "de": "Behalten Sie eau.veolia.fr, außer Ihre Gemeinde leitet Sie auf ein eigenes Veolia-Portal weiter.",
        "es": "Deje eau.veolia.fr salvo que su municipio le redirija a su propio portal de Veolia."
      },
      "required": false,
      "default": "eau.veolia.fr",
      "options": [
        {
          "value": "eau.veolia.fr",
          "label": {
            "en": "Veolia (eau.veolia.fr)",
            "fr": "Veolia (eau.veolia.fr)",
            "de": "Veolia (eau.veolia.fr)",
            "es": "Veolia (eau.veolia.fr)"
          }
        },
        {
          "value": "eaudetm.monespace.eau.veolia.fr",
          "label": {
            "en": "Eau de Toulouse Métropole",
            "fr": "Eau de Toulouse Métropole",
            "de": "Eau de Toulouse Métropole",
            "es": "Eau de Toulouse Métropole"
          }
        }
      ]
    },
    {
      "key": "refresh_hours",
      "type": "number",
      "label": {
        "en": "Refresh interval (h)",
        "fr": "Intervalle de rafraîchissement (h)",
        "de": "Aktualisierungsintervall (h)",
        "es": "Intervalo de actualización (h)"
      },
      "description": {
        "en": "How often the Veolia portal is read, in hours. Veolia publishes one reading a day.",
        "fr": "Fréquence de lecture du portail Veolia, en heures. Veolia publie un relevé par jour.",
        "de": "Wie oft das Veolia-Portal gelesen wird, in Stunden. Veolia veröffentlicht einen Messwert pro Tag.",
        "es": "Cada cuánto se lee el portal de Veolia, en horas. Veolia publica una lectura al día."
      },
      "required": false,
      "default": 6,
      "min": 1,
      "max": 24
    },
    {
      "key": "high_consumption_liters",
      "type": "number",
      "label": {
        "en": "High consumption threshold (L/day)",
        "fr": "Seuil de forte consommation (L/jour)",
        "de": "Schwelle für hohen Verbrauch (L/Tag)",
        "es": "Umbral de consumo alto (L/día)"
      },
      "description": {
        "en": "A day at or above this many litres fires the \"High consumption\" scene trigger. 0 turns it off.",
        "fr": "Une journée à ce nombre de litres ou plus lance le déclencheur de scène « Forte consommation ». 0 le désactive.",
        "de": "Ein Tag mit mindestens so vielen Litern löst den Szenen-Auslöser „Hoher Wasserverbrauch“ aus. 0 schaltet ihn ab.",
        "es": "Un día con esta cantidad de litros o más lanza el activador de escena «Consumo de agua alto». 0 lo desactiva."
      },
      "placeholder": {
        "en": "e.g. 500",
        "fr": "ex. 500",
        "de": "z. B. 500",
        "es": "p. ej. 500"
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 100000
    },
    {
      "key": "overdue_days",
      "type": "number",
      "label": {
        "en": "Missing reading after (days)",
        "fr": "Relevé manquant après (jours)",
        "de": "Fehlender Messwert nach (Tagen)",
        "es": "Lectura ausente tras (días)"
      },
      "description": {
        "en": "Days without a new reading before the \"Reading overdue\" scene trigger fires.",
        "fr": "Nombre de jours sans nouveau relevé avant le déclencheur de scène « Relevé en retard ».",
        "de": "Tage ohne neuen Messwert, bevor der Szenen-Auslöser „Wasser-Messwert überfällig“ auslöst.",
        "es": "Días sin lectura nueva antes de que se lance el activador de escena «Lectura de agua atrasada»."
      },
      "required": false,
      "default": 3,
      "min": 1,
      "max": 30
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 90
    },
    {
      "key": "check_town",
      "label": {
        "en": "Check my town",
        "fr": "Vérifier ma commune",
        "de": "Meine Gemeinde prüfen",
        "es": "Comprobar mi municipio"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "postal_code",
          "type": "string",
          "label": {
            "en": "Postal code",
            "fr": "Code postal",
            "de": "Postleitzahl",
            "es": "Código postal"
          },
          "placeholder": {
            "en": "e.g. 57000",
            "fr": "ex. 57000",
            "de": "z. B. 57000",
            "es": "p. ej. 57000"
          },
          "required": true
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "new_reading",
      "label": {
        "en": "New water reading",
        "fr": "Nouveau relevé d'eau",
        "de": "Neuer Wasser-Messwert",
        "es": "Nueva lectura de agua"
      },
      "description": {
        "en": "Veolia published the consumption of a new day.",
        "fr": "Veolia a publié la consommation d'une nouvelle journée.",
        "de": "Veolia hat den Verbrauch eines neuen Tages veröffentlicht.",
        "es": "Veolia ha publicado el consumo de un nuevo día."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur",
            "de": "Zähler",
            "es": "Contador"
          }
        }
      ],
      "variables": [
        {
          "key": "date",
          "type": "string",
          "label": {
            "en": "Reading date",
            "fr": "Date du relevé",
            "de": "Datum des Messwerts",
            "es": "Fecha de la lectura"
          }
        },
        {
          "key": "liters",
          "type": "number",
          "label": {
            "en": "Litres used that day",
            "fr": "Litres consommés ce jour-là",
            "de": "An diesem Tag verbrauchte Liter",
            "es": "Litros consumidos ese día"
          }
        },
        {
          "key": "index_m3",
          "type": "number",
          "label": {
            "en": "Meter index (m³)",
