    {
      "key": "high_consumption",
      "label": {
        "en": "High water consumption",
        "fr": "Forte consommation d'eau",
        "de": "Hoher Wasserverbrauch",
        "es": "Consumo de agua alto"
      },
      "description": {
        "en": "A day reached the threshold set in the configuration (possible leak).",
        "fr": "Une journée a atteint le seuil réglé dans la configuration (fuite possible).",
        "de": "Ein Tag hat die in der Konfiguration eingestellte Schwelle erreicht (mögliches Leck).",
        "es": "Un día ha alcanzado el umbral fijado en la configuración (posible fuga)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur",
            "de": "Zähler",
            "es": "Contador"
          }
        }
      ],
      "variables": [
        {
          "key": "date",
          "type": "string",
          "label": {
            "en": "Day",
            "fr": "Jour",
            "de": "Tag",
            "es": "Día"
          }
        },
        {
          "key": "liters",
          "type": "number",
          "label": {
            "en": "Litres used that day",
            "fr": "Litres consommés ce jour-là",
            "de": "An diesem Tag verbrauchte Liter",
            "es": "Litros consumidos ese día"
          }
        },
        {
          "key": "threshold_liters",
          "type": "number",
          "label": {
            "en": "Threshold (L)",
            "fr": "Seuil (L)",
            "de": "Schwelle (L)",
            "es": "Umbral (L)"
          }
        }
      ]
    },
    {
      "key": "reading_overdue",
      "label": {
        "en": "Water reading overdue",
        "fr": "Relevé d'eau en retard",
        "de": "Wasser-Messwert überfällig",
        "es": "Lectura de agua atrasada"
      },
      "description": {
        "en": "No new reading for the number of days set in the configuration.",
        "fr": "Aucun nouveau relevé depuis le nombre de jours réglé dans la configuration.",
        "de": "Kein neuer Messwert seit der in der Konfiguration eingestellten Anzahl von Tagen.",
        "es": "Ninguna lectura nueva desde el número de días fijado en la configuración."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur",
            "de": "Zähler",
            "es": "Contador"
          }
        }
      ],
      "variables": [
        {
          "key": "last_date",
          "type": "string",
          "label": {
            "en": "Last reading date",
            "fr": "Date du dernier relevé",
